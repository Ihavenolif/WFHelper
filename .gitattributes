# Normalize all text to LF on checkout, regardless of core.autocrlf.
# CRLF trips prettier's endOfLine check and breaks knip's script parsing.
* text=auto eol=lf

*.png binary
*.jpg binary
*.webp binary
*.dds binary
*.ico binary
*.wav binary
*.onnx binary

# Message catalogues are data, not code: keep them out of the language stats so
# a repo with many locales still reads as a TypeScript project. Diffs stay
# normal on purpose, because the German copy is reviewed by hand.
src/i18n/*.json linguist-detectable=false
